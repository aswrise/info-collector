<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.pi.podcast-bookmarks</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/sandbox-exec</string>
        <string>-p</string>
        <string>(version 1)(allow default)(deny file-read* file-write* (subpath "__HOME__/Library"))</string>
        <string>__PYTHON__</string>
        <string>__HOME__/.pi/scripts/podcast-bookmarks.py</string>
    </array>

    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>__PATH__</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/.pi/logs/podcast-bookmarks.launchd.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.pi/logs/podcast-bookmarks.launchd.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
